-- Finds nearest player head relative specifically to where you are LOOKING (Cursor Center)
local function getCursorTargetHead()
    local closestTarget = nil
    local shortestDistance = math.huge
    local centerScreen = camera.ViewportSize / 2
    local myChar = localPlayer.Character
    if not myChar then return nil end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end

    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= localPlayer and plr.Character then
            local head = plr.Character:FindFirstChild("Head")
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                -- Step 1: Distance limit filter check
                local studDist = (head.Position - myHrp.Position).Magnitude
                if studDist <= AIM_MAX_STUDS then
                    local screenPos, visible = camera:WorldToViewportPoint(head.Position)
                    
                    -- Step 2: Ensure target context is visible on screen to get cursor offset
                    if visible then
                        local cursorOffset = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                        if cursorOffset < shortestDistance then
                            shortestDistance = cursorOffset
                            closestTarget = head
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

