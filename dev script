local activeArrows = {}

RunService.RenderStepped:Connect(function(dt)
    -- Part A: Aimbot Kinematics Execution
    if aimbotEnabled and not mouseOverridden then
        local targetHead = getCursorTargetHead()
        if targetHead then
            local centerScreen = camera.ViewportSize / 2
            local screenPos, _ = camera:WorldToViewportPoint(targetHead.Position)
            local cursorOffset = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
            
            -- Dynamic variable sticky lock zones
            local currentLerpSpeed = 0.06
            if cursorOffset < 65 then
                currentLerpSpeed = 0.45 
            end

            local targetCFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
            camera.CFrame = camera.CFrame:Lerp(targetCFrame, currentLerpSpeed)
        end
    elseif mouseOverridden then
        overrideCooldown = overrideCooldown - dt
        if overrideCooldown <= 0 then mouseOverridden = false end
    end

    -- Part B: Perimeter 2D Arrow Tracking Pipeline
    if not tracersEnabled then 
        -- Clean up cache if disabled during run frame
        if next(activeArrows) then
            screenGui:ClearAllChildren()
            activeArrows = {}
        end
        return 
    end

    local currentPlayers = game:GetService("Players"):GetPlayers()
    local screenSize = camera.ViewportSize
    local margin = 35 -- Safe spacing pixel depth gap inside the absolute borders of screen display
    local trackedThisFrame = {}

    -- Create or maintain unique visual UI components for active users
    for _, plr in ipairs(currentPlayers) do
        if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local root = plr.Character.HumanoidRootPart
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            
            if humanoid and humanoid.Health > 0 then
                local screenPos, visible = camera:WorldToViewportPoint(root.Position)
                local arrow = activeArrows[plr.Name]

                if not arrow then
                    -- Create explicit triangle graphic layout asset components
                    arrow = Instance.new("TextLabel")
                    arrow.Name = plr.Name
                    arrow.Size = UDim2.new(0, 24, 0, 24)
                    arrow.AnchorPoint = Vector2.new(0.5, 0.5)
                    arrow.BackgroundTransparency = 1
                    arrow.Text = "▲" -- Triangle indicator vector character asset
                    arrow.Font = Enum.Font.GothamBold
                    arrow.TextSize = 22
                    arrow.TextColor3 = Color3.fromRGB(240, 150, 255)
                    arrow.Parent = screenGui
                    activeArrows[plr.Name] = arrow
                end

                trackedThisFrame[plr.Name] = true

                if not visible then
                    -- Math to project target screen vector position if character lies out of field-of-view layout limits
                    local dir = (camera.CFrame:PointToObjectSpace(root.Position)).Unit
                    local angle = math.atan2(dir.X, -dir.Z)
                    
                    local center = screenSize / 2
                    local rDir = Vector2.new(math.sin(angle), -math.cos(angle))
                    
                    -- Raycasting to find screen boundary intersection points
                    local tx = math.huge
                    local ty = math.huge
                    
                    if rDir.X > 0 then tx = (center.X - margin) / rDir.X elseif rDir.X < 0 then tx = (-center.X + margin) / rDir.X end
                    if rDir.Y > 0 then ty = (center.Y - margin) / rDir.Y elseif rDir.Y < 0 then ty = (-center.Y + margin) / rDir.Y end
                    
                    local t = math.min(tx, ty)
                    local edgePos = center + (rDir * t)
                    
                    -- Apply positional updates and orientation angles
                    arrow.Visible = true
                    arrow.Position = UDim2.new(0, edgePos.X, 0, edgePos.Y)
                    arrow.Rotation = math.deg(angle)
                else
                    -- Hide arrow entirely if target is perfectly framed on your primary camera center screen
                    arrow.Visible = false
                end
            end
        end
    end

    -- Clear inactive visual labels for users who disconnected or died
    for name, arrow in pairs(activeArrows) do
        if not trackedThisFrame[name] then
            arrow:Destroy()
            activeArrows[name] = nil
        end
    end
end)
