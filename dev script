-- Handles toggling the script tracking loops
local function toggleMapMode()
	local char = localPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	mapActive = not mapActive

	if mapActive then
		-- Entering Map Mode: Initialize target camera over your current physical location
		currentTargetPos = hrp.Position
		targetHeight = 150
		lastMousePos = UIS:GetMouseLocation()
		camera.CameraType = Enum.CameraType.Scriptable
	else
		-- Exiting Map Mode: Hand camera control back to normal CoreScripts
		camera.CameraType = Enum.CameraType.Custom
	end
end

-- Input Begin Observers
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end

	-- 1. Check Toggle State Hotkey
	if input.KeyCode == CONFIG.mapToggleKey then
		toggleMapMode()
	end

	if not mapActive then return end

	-- 2. Check left click drag tracking parameters
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingMap = true
		lastMousePos = UIS:GetMouseLocation()
	end

	-- 3. Check right click map ground teleport interactions
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		local mousePos = UIS:GetMouseLocation()
		local ray = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
		
		-- Use raycasting filters to query ground intersection geometries accurately
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		if localPlayer.Character then
			raycastParams.FilterInstances = {localPlayer.Character}
		end

		local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, raycastParams)
		if result then
			local char = localPlayer.Character
			if char and char:FindFirstChild("HumanoidRootPart") then
				-- Teleport character directly to hit spot
				char.HumanoidRootPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
			end
		end
	end
end)

-- Input End Observers
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingMap = false
	end
end)

-- Scroll Wheel Dynamic Adjustment Handler (Zoom Loop Engine)
UIS.InputChanged:Connect(function(input, processed)
	if not mapActive or processed then return end

	if input.UserInputType == Enum.UserInputType.MouseWheel then
		-- Adjust standard target height metrics using custom scalar delta settings
		targetHeight = math.clamp(
			targetHeight - (input.Position.Z * CONFIG.mapZoomSensitivity), 
			CONFIG.mapMinZoom, 
			CONFIG.mapMaxZoom
		)
	end
end)

-- Kinematic Framing Calculations Loop runs on Render Step Frame updates
RunService.RenderStepped:Connect(function(dt)
	if not mapActive then return end

	-- HARD FORCED OVERRIDE: Prevent default Roblox scripts from breaking scriptable mode
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	-- 1. Calculate Vector Shift Movements across Drag Transitions
	if isDraggingMap then
		local currentMousePos = UIS:GetMouseLocation()
		local delta = currentMousePos - lastMousePos
		lastMousePos = currentMousePos

		-- Translate raw pixels into 3D space plane metrics relative to height zoom depth
		local conversionFactor = (targetHeight / 1000) * CONFIG.mapDragSensitivity
		
		-- Pull camera coordinates along flat cardinal angles based on screen drag deltas
		currentTargetPos = currentTargetPos + Vector3.new(delta.X * conversionFactor, 0, delta.Y * conversionFactor)
	end

	-- 2. Linear Interpolate Camera Vector Transformations (Handles the smooth overhead flight)
	local desiredCFramePosition = currentTargetPos + Vector3.new(0, targetHeight, 0)
	
	-- Rotate camera down facing target map arrays perpendicularly
	local desiredCFrame = CFrame.new(desiredCFramePosition, desiredCFramePosition - Vector3.new(0, 1, 0.001))
	
	camera.CFrame = camera.CFrame:Lerp(desiredCFrame, CONFIG.mapTransitionSpeed)
end)
