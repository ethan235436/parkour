------------------------------------------------
-- CREATE ESP
------------------------------------------------

local function createESP(plr, permanent)

	if not plr.Character then
		return
	end

	local oldFlash = plr.Character:FindFirstChild("FlashESP")
	local oldTrack = plr.Character:FindFirstChild("TrackedESP")

	if permanent and oldTrack then
		oldTrack:Destroy()
	elseif not permanent and oldFlash then
		oldFlash:Destroy()
	end


	local highlight = Instance.new("Highlight")

	highlight.Name = permanent and "TrackedESP" or "FlashESP"
	highlight.Adornee = plr.Character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	-- Check friendship tiers
	local isDirectFriend = player:IsFriendsWith(plr.UserId)
	local isMutualFriend = false

	if not isDirectFriend then
		-- Scan the current server for mutual connections
		for _, otherPlr in ipairs(Players:GetPlayers()) do
			if otherPlr ~= player and otherPlr ~= plr then
				if player:IsFriendsWith(otherPlr.UserId) and otherPlr:IsFriendsWith(plr.UserId) then
					isMutualFriend = true
					break
				end
			end
		end
	end

	-- Apply colors based on relationship tier
	if isDirectFriend then
		highlight.FillColor = Color3.fromRGB(140, 255, 140) -- Light Green (Direct Friend)
		highlight.OutlineColor = Color3.fromRGB(200, 255, 200)
	elseif isMutualFriend then
		highlight.FillColor = Color3.fromRGB(255, 255, 140) -- Yellow (Mutual Friend)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 200)
	else
		highlight.FillColor = Color3.fromRGB(0,220,255) -- Light Blue (Default)
		highlight.OutlineColor = Color3.fromRGB(150,245,255)
	end

	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 1

	highlight.Parent = plr.Character


	TweenService:Create(
		highlight,
		TweenInfo.new(
			FADE_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			FillTransparency = permanent and 0.65 or 0.75,
			OutlineTransparency = 0.15
		}
	):Play()

	return highlight
end


